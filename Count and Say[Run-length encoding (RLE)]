class Solution {
    public String countAndSay(int n) {
        String str = "1";

        for (int k = 1; k < n; k++) {
            StringBuilder sb = new StringBuilder();

            for (int i = 0; i < str.length();) {
                int j = i;

                while (j < str.length() && str.charAt(i) == str.charAt(j)) {
                    j++;
                }

                sb.append(j - i);
                sb.append(str.charAt(i));

                i = j;
            }

            str = sb.toString();
        }

        return str;
    }
}
